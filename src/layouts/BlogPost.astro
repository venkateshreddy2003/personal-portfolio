---
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} - Venkatesh Reddy Pitchala`} description={description} image={heroImage} />
	</head>

	<body class="bg-paper text-ink antialiased flex flex-col min-h-screen">
		<Header />
		<main class="flex-1 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 w-full">
			<div class="mb-8">
				<a 
					href="/blog" 
					class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted hover:text-ink transition-colors"
				>
					<ArrowLeft class="size-4" /> Back to Blog
				</a>
			</div>

			<article>
				<header class="mb-8">
					{pubDate && (
						<p class="text-xs sm:text-sm font-bold text-accent tracking-wider uppercase mb-3">
							<FormattedDate date={pubDate} />
						</p>
					)}
					<h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-[1.1]">
						{title}
					</h1>
					{description && (
						<p class="mt-4 text-base sm:text-lg text-muted leading-relaxed max-w-3xl font-normal">
							{description}
						</p>
					)}
					{heroImage && (
						<img
							src={heroImage.src}
							alt={`Illustration for ${title}`}
							class="mt-8 w-full rounded-2xl border border-line object-cover shadow-sm"
						/>
					)}
				</header>

				<div class="article-content mt-8 border-t border-line/40 pt-8">
					<slot />
				</div>
			</article>
		</main>
		<Footer showContact={false} />
	</body>
</html>
