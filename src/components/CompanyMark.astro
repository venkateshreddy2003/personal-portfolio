---
interface Props {
  logo?: string;
  name: string;
}

const { logo, name } = Astro.props;
---

<div class="size-9 sm:size-10 rounded-xl border border-line bg-white flex items-center justify-center overflow-hidden shrink-0 shadow-xs">
  {logo ? (
    <img src={logo} alt={name} class="size-full object-contain p-1" />
  ) : (
    <span class="text-sm font-bold text-accent">
      {name.charAt(0)}
    </span>
  )}
</div>
