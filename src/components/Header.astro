---
import HeaderLink from './HeaderLink.astro';
import { Sun, Moon, Menu, X } from '@lucide/astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--header)] transition-colors h-16 sm:h-[72px] flex items-center" transition:name="nav-header">
  <nav class="max-w-7xl mx-auto w-full flex items-center justify-between px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Always visible: Home link -->
      <HeaderLink href="/">Home</HeaderLink>
      
      <!-- Visible only on 640px+ (Tablet & Desktop): Blog and Projects -->
      <div class="hidden sm:flex items-center gap-1.5 sm:gap-2">
        <HeaderLink href="/blog">Blog</HeaderLink>
        <HeaderLink href="/projects">Projects</HeaderLink>
      </div>
    </div>
    
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Theme Toggle -->
      <button 
        id="theme-toggle" 
        aria-label="Toggle theme"
        class="p-2 rounded-full border border-line bg-paper text-ink hover:bg-paper-dark transition-all cursor-pointer shadow-xs flex items-center justify-center"
      >
        <Sun class="size-4 block [html[data-theme='dark']_&]:hidden text-amber-500" />
        <Moon class="size-4 hidden [html[data-theme='dark']_&]:block text-indigo-400" />
      </button>

      <!-- Hamburger Menu Button (Mobile below 640px) -->
      <button
        id="mobile-menu-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="p-2 rounded-full border border-line bg-paper text-ink hover:bg-paper-dark transition-all cursor-pointer shadow-xs sm:hidden flex items-center justify-center"
      >
        <Menu id="menu-icon-open" class="size-5 block" />
        <X id="menu-icon-close" class="size-5 hidden" />
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu (below 640px) -->
  <div 
    id="mobile-menu" 
    class="hidden sm:hidden absolute top-full left-0 right-0 bg-paper/98 backdrop-blur-xl border-b border-line p-4 transition-all duration-200 shadow-lg"
  >
    <div class="flex flex-col gap-2 max-w-7xl mx-auto" id="mobile-menu-links">
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
    </div>
  </div>
</header>

<script is:inline>
  const applyTheme = () => {
    const theme = (() => {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        return 'dark';
      }
      return 'light';
    })();
    
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  };

  applyTheme();

  const bindHeaderEvents = () => {
    // Theme toggle
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn && !toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = 'true';
      toggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }

    // Mobile menu toggle
    const menuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (menuToggle && mobileMenu && !menuToggle.dataset.bound) {
      menuToggle.dataset.bound = 'true';

      const closeMenu = () => {
        mobileMenu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        if (iconOpen) iconOpen.classList.remove('hidden');
        if (iconClose) iconClose.classList.add('hidden');
      };

      const openMenu = () => {
        mobileMenu.classList.remove('hidden');
        menuToggle.setAttribute('aria-expanded', 'true');
        if (iconOpen) iconOpen.classList.add('hidden');
        if (iconClose) iconClose.classList.remove('hidden');
      };

      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !mobileMenu.classList.contains('hidden');
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Close menu after selecting any link in mobile menu
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      // Close menu when clicking outside
      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target) && !menuToggle.contains(e.target)) {
          closeMenu();
        }
      });
    }
  };

  bindHeaderEvents();
  document.addEventListener('DOMContentLoaded', bindHeaderEvents);
  document.addEventListener('astro:page-load', () => {
    applyTheme();
    bindHeaderEvents();
  });
  document.addEventListener('astro:after-swap', applyTheme);
</script>

